# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# env / secrets — never commit these
.env
*.key
*.pem
secrets/

# lab infrastructure state & credentials (tracks/stack/labs) — state files can hold secrets in plain text
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars
crash.log
kubeconfig*
*.kubeconfig
.aws/
credentials
*.vault-token
.vault-token

# data & models — too big / not source
data/
*.db
*.sqlite
models/
*.gguf
*.onnx

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# today's local swap/bonus choice - per computer, never synced
logs/.today.json
